FOURTHWALL_WEBHOOK_SECRET=
NEXT_PUBLIC_FW_API_URL=
NEXT_PUBLIC_FW_CHECKOUT=
NEXT_PUBLIC_FW_COLLECTION=
NEXT_PUBLIC_FW_STOREFRONT_TOKEN=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_USE_FW_IMAGE_OPTIMIZATION=
NEXT_PUBLIC_VERCEL_URL=

# Fourthwall Platform API write credentials (server-only, never exposed to the client).
# Platform API host. Distinct from the Storefront API host above — do not derive one from
# the other. Defaults to https://api.fourthwall.com when unset.
FOURTHWALL_PLATFORM_API_URL=
# Basic auth pair — these are the names provisioned in Vercel.
FOURTHWALL_API_USERNAME=
FOURTHWALL_API_PASSWORD=
# Optional bearer token. When set it takes precedence over the Basic auth pair.
FOURTHWALL_ACCESS_TOKEN=
# Legacy aliases, consulted only when the preferred names above are unset.
FOURTHWALL_API_KEY=
FOURTHWALL_API_SECRET=

# Basic auth gate for /import and /api/import/fourthwall.
# Unset in production returns 503 rather than exposing the admin surface.
IMPORT_ADMIN_USER=
IMPORT_ADMIN_PASSWORD=
